#compdef loqctl
# SPDX-License-Identifier: GPL-3.0-or-later
# zsh completion for loqctl. Static: never runs loqctl.
local -a modes
modes=(low-power balanced performance max-power custom)
# Gamezone's class device first, then any other, then the legacy file (it lists "custom", which the kernel rejects).
local f src=""
for f in /sys/class/platform-profile/*/choices(N.r); do
    [[ -e ${f%choices}profile ]] || continue
    [[ -z $src ]] && src=$f
    [[ -r ${f%choices}name && $(< ${f%choices}name) == lenovo-wmi-gamezone ]] && { src=$f; break; }
done
[[ -z $src ]] && src=/sys/firmware/acpi/platform_profile_choices
[[ -r $src ]] && modes=(${=$(< $src)})

_arguments -C \
    '--socket[connect to an existing loqctl Unix socket]:socket:_files' \
    '--version[show the version]' \
    '(-h --help)'{-h,--help}'[show help]' \
    '1: :(tui status metrics capabilities limits fan mode set battery toggle profile kb doctor serve)' \
    '*:: :->args'

case $state in
    args)
        case $words[1] in
            metrics) _arguments '--watch=[print one JSON line every SECONDS]:seconds' ;;
            serve) _arguments '--uid=[UID permitted to connect]:uid' ;;
            battery) (( CURRENT == 2 )) && _values battery normal conservation rapid ;;
            toggle) (( CURRENT == 2 )) && _values toggle fn_lock camera winkey logo_light port_light ;;
            profile) (( CURRENT == 2 )) && _values profile list save apply ;;
            mode) _values mode $modes ;;
            set) (( CURRENT == 2 )) && _values attribute ppt_pl1_spl ppt_pl2_sppt ppt_cpu_cl ppt_pl1_spl_cl ppt_pl2_sppt_cl ppt_pl3_fppt ppt_pl3_fppt_cl ppt_pl4_ipl ppt_pl4_ipl_cl ppt_pl1_apu_spl ppt_pl1_tau cpu_temp gpu_nv_ctgp gpu_nv_ppab gpu_nv_ac_offset gpu_nv_bpl gpu_nv_cpu_boost gpu_temp ;;
            kb)
                if (( CURRENT == 2 )); then
                    _values action status apply off static breath wave hue brightness
                else
                    case $words[2] in
                        static|breath|hue) _values option --speed --brightness ;;
                        wave) _values option ltr rtl --speed --brightness ;;
                    esac
                fi ;;
        esac ;;
esac
